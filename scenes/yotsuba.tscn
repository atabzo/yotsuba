[sub_resource type="GDScript" id="GDScript_ivegd"]
script/source = "extends CharacterBody2D

const SPEED = 200.0
const ACCELERATION = 1500.0
const FRICTION = 1800.0
const JUMP_VELOCITY = -400.0
const GRAVITY = 1200.0
const JUMP_CUT_MULTIPLIER = 0.5
const COYOTE_TIME = 0.12
const JUMP_BUFFER_TIME = 0.12

var facing_direction = 1
var coyote_timer = 0.0
var jump_buffer_timer = 0.0
var was_on_floor = true

@export var flower_scene: PackedScene

func _physics_process(delta):
	var on_floor = is_on_floor()

	if not on_floor:
		velocity.y += GRAVITY * delta
		coyote_timer -= delta
	else:
		coyote_timer = COYOTE_TIME

	var direction = Input.get_axis(\"move_left\", \"move_right\")
	if direction != 0:
		velocity.x = move_toward(velocity.x, direction * SPEED, ACCELERATION * delta)
		if sign(direction) != facing_direction:
			facing_direction = sign(direction)
			_on_direction_changed()
	else:
		velocity.x = move_toward(velocity.x, 0, FRICTION * delta)

	if Input.is_action_just_pressed(\"jump\"):
		jump_buffer_timer = JUMP_BUFFER_TIME
	jump_buffer_timer -= delta

	if jump_buffer_timer > 0 and coyote_timer > 0:
		velocity.y = JUMP_VELOCITY
		jump_buffer_timer = 0
		coyote_timer = 0
		_on_jump_started()

	if Input.is_action_just_released(\"jump\") and velocity.y < 0:
		velocity.y *= JUMP_CUT_MULTIPLIER

	move_and_slide()

	if is_on_floor() and not was_on_floor:
		_on_landed()
	was_on_floor = is_on_floor()

	if Input.is_action_just_pressed(\"shoot\"):
		shoot_flower()

func _on_direction_changed():
	var tween = create_tween()
	tween.tween_property(self, \"scale\", Vector2(0.85, 1.15), 0.08)
	tween.tween_property(self, \"scale\", Vector2(1.0, 1.0), 0.12).set_trans(Tween.TRANS_BACK)

func _on_jump_started():
	var tween = create_tween()
	tween.tween_property(self, \"scale\", Vector2(1.2, 0.75), 0.06)
	tween.tween_property(self, \"scale\", Vector2(0.8, 1.25), 0.12).set_trans(Tween.TRANS_QUAD)

func _on_landed():
	var tween = create_tween()
	tween.tween_property(self, \"scale\", Vector2(1.3, 0.7), 0.08)
	tween.tween_property(self, \"scale\", Vector2(1.0, 1.0), 0.15).set_trans(Tween.TRANS_BACK)

func shoot_flower():
	if flower_scene == null:
		return
	var flower = flower_scene.instantiate()
	flower.global_position = global_position + Vector2(20 * facing_direction, 0)
	flower.direction = facing_direction
	get_parent().add_child(flower)
"

